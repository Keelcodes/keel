    "clean": "rm -rf dist"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "vitest": "^2.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "erc-4337",
    "erc-7579",
    "policy",
    "session-keys",
    "agent",
    "account-abstraction"
  ]
}
