# RPC endpoints per chain. All optional — leave blank to use viem's public default.
VITE_RPC_ETHEREUM=
VITE_RPC_BASE=
VITE_RPC_BSC=

# WalletConnect v2 project id (https://cloud.reown.com). Optional: browser
# extension wallets are discovered automatically via EIP-6963. Set this only to
# offer the WalletConnect QR / mobile fallback; left blank, the connector is not
# registered at all.
VITE_WC_PROJECT_ID=

# Conformance panel: the module the ERC-7579 suite checks against the connected
# account. Both optional — without VITE_CONFORMANCE_MODULE the panel defaults to
# the deployed KeelPolicyHook.
VITE_CONFORMANCE_MODULE=
# ERC-7579 module type id: 1 validator, 2 executor, 3 fallback, 4 hook (default).
VITE_CONFORMANCE_MODULE_TYPE=

# Console backend (@keelcodes/api) — the session index + settlement ledger the
# chain cannot answer. Optional: unset, the Settlement panel keeps its "not
# deployed" empty state and nothing is fetched.
VITE_API_URL=
