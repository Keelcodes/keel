{
  "name": "@keelcodes/console",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-chain Keel console (Base / BSC / Ethereum) — React + Vite + wagmi.",
  "license": "Apache-2.0",
  "homepage": "https://keel.codes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@keelcodes/conformance": "workspace:*",
    "@keelcodes/policy": "workspace:*",
    "@keelcodes/settlement": "workspace:*",
    "@tanstack/react-query": "^5.59.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.0",
    "wagmi": "^2.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
